{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlayerResponseDTO, exactly as the OpenAPI document defines it",
  "description": "id is an integer and the required list includes currency_code; password fields are not part of the response.",
  "type": "object",
  "required": ["id", "currency_code", "email", "name", "surname", "username"],
  "properties": {
    "id": { "type": "integer" },
    "currency_code": { "type": "string" },
    "username": { "type": "string" },
    "email": { "type": "string" },
    "name": { "type": "string" },
    "surname": { "type": "string" }
  },
  "not": {
    "anyOf": [
      { "required": ["password_change"] },
      { "required": ["password_repeat"] }
    ]
  }
}
